// Farm OS - Prisma schema
// Implements the approved Stage 1 database design (multi-species livestock,
// ledger-based inventory, farm isolation, audit trail, offline-sync-ready fields).
//
// NOTE ON SCOPE: this file defines the complete approved domain model so the
// database doesn't need re-migration as later sprints add business logic.
// Sprint 1 only builds services/controllers for: User, Role, Farm, FarmMember.
// All other models exist here as agreed schema, ready for Sprint 2+.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── OFFLINE-SYNC-READY BASE FIELDS ──────────────────────────────────────────
// Every model below carries id (uuid), createdAt, updatedAt, deletedAt (soft
// delete), and version (optimistic concurrency / future conflict resolution),
// per the Stage 3 "OFFLINE SUPPORT" requirement.

// ── ACCESS CONTROL ───────────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  fullName        String
  email           String?  @unique
  phone           String?  @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  refreshTokenHash String? // hashed refresh token for rotation/revocation
  passwordResetCodeHash String?
  passwordResetExpiresAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  version         Int      @default(1)

  ownedFarms  Farm[]       @relation("FarmOwner")
  memberships FarmMember[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique // 'farmer' | 'farm_manager' | 'admin'

  members FarmMember[]

  @@map("roles")
}

model Farm {
  id              String    @id @default(uuid())
  ownerUserId     String
  owner           User      @relation("FarmOwner", fields: [ownerUserId], references: [id])
  name            String
  phone           String?
  email           String?
  location        String?
  region          String?
  country         String?
  farmType        String?
  registrationNo  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  version         Int       @default(1)

  members             FarmMember[]
  species             Species[]
  animalCategories    AnimalCategory[]
  animalMovements     AnimalMovement[]
  feedItems           FeedItem[]
  feedTransactions    FeedTransaction[]
  drugItems           DrugItem[]
  drugTransactions    DrugTransaction[]
  treatments          Treatment[]
  equipment           Equipment[]
  parties             Party[]
  purchases           Purchase[]
  expenses            Expense[]
  sales               Sale[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@index([ownerUserId])
  @@map("farms")
}

model FarmMember {
  id        String   @id @default(uuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  version   Int      @default(1)

  @@unique([farmId, userId])
  @@index([userId])
  @@map("farm_members")
}

// ── LIVESTOCK (species-generic) ─────────────────────────────────────────────

model Species {
  id        Int      @id @default(autoincrement())
  farmId    String? // null = system default species (Pig, Dog, Dairy Cattle, Chicken)
  farm      Farm?    @relation(fields: [farmId], references: [id])
  name      String
  createdAt DateTime @default(now())

  categories AnimalCategory[]
  movements  AnimalMovement[]
  feedItems  FeedItem[]

  @@index([farmId])
  @@map("species")
}

model AnimalCategory {
  id        Int      @id @default(autoincrement())
  speciesId Int
  species   Species  @relation(fields: [speciesId], references: [id])
  farmId    String? // null = system default category for that species
  farm      Farm?    @relation(fields: [farmId], references: [id])
  name      String
  createdAt DateTime @default(now())

  movements  AnimalMovement[]
  treatments Treatment[]

  @@index([speciesId])
  @@index([farmId])
  @@map("animal_categories")
}

enum MovementType {
  OPENING
  BIRTH
  PURCHASE
  SALE
  DEATH
  CULL
  TRANSFER
  ADJUSTMENT
}

model AnimalMovement {
  id           String       @id @default(uuid())
  farmId       String
  farm         Farm         @relation(fields: [farmId], references: [id])
  speciesId    Int
  species      Species      @relation(fields: [speciesId], references: [id])
  categoryId   Int
  category     AnimalCategory @relation(fields: [categoryId], references: [id])
  movementType MovementType
  quantity     Int
  movementDate DateTime
  referenceId  String? // links to Purchase.id or Sale.id when relevant
  notes        String?
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  version      Int          @default(1)

  @@index([farmId, speciesId, categoryId])
  @@index([farmId, movementDate])
  @@map("animal_movements")
}

// ── FEED ──────────────────────────────────────────────────────────────────

model FeedItem {
  id             String    @id @default(uuid())
  farmId         String
  farm           Farm      @relation(fields: [farmId], references: [id])
  speciesId      Int?      // null = generic/shared feed
  species        Species?  @relation(fields: [speciesId], references: [id])
  name           String
  feedType       String    // configurable, farm-defined (e.g. Maize Bran, Dairy Meal)
  unit           String    @default("kg")
  bagSizeKg      Decimal?  @db.Decimal(8, 2)
  minStockKg     Decimal?  @db.Decimal(10, 2)
  storageLocation String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  version        Int       @default(1)

  transactions FeedTransaction[]

  @@index([farmId])
  @@map("feed_items")
}

enum FeedTxnType {
  OPENING
  PURCHASE
  USAGE
  WASTE
  ADJUSTMENT
}

model FeedTransaction {
  id               String      @id @default(uuid())
  feedItemId       String
  feedItem         FeedItem    @relation(fields: [feedItemId], references: [id])
  farmId           String
  farm             Farm        @relation(fields: [farmId], references: [id])
  txnType          FeedTxnType
  quantityKg       Decimal     @db.Decimal(10, 2)
  costPerUnit      Decimal?    @db.Decimal(10, 2)
  totalCost        Decimal?    @db.Decimal(12, 2)
  batchNumber      String?
  expiryDate       DateTime?
  supplierPartyId  String?
  supplierParty    Party?      @relation(fields: [supplierPartyId], references: [id])
  txnDate          DateTime
  notes            String?
  createdById      String?
  createdAt        DateTime    @default(now())
  version          Int         @default(1)

  purchases Purchase[]

  @@index([farmId, feedItemId])
  @@index([farmId, txnDate])
  @@map("feed_transactions")
}

// ── DRUGS & VACCINES ─────────────────────────────────────────────────────

model DrugItem {
  id          String    @id @default(uuid())
  farmId      String
  farm        Farm      @relation(fields: [farmId], references: [id])
  name        String
  category    String?
  unit        String?
  minStock    Decimal?  @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)

  transactions DrugTransaction[]
  treatments   Treatment[]

  @@index([farmId])
  @@map("drug_items")
}

enum DrugTxnType {
  OPENING
  PURCHASE
  USAGE
  WASTE
  ADJUSTMENT
}

model DrugTransaction {
  id          String      @id @default(uuid())
  drugItemId  String
  drugItem    DrugItem    @relation(fields: [drugItemId], references: [id])
  farmId      String
  farm        Farm        @relation(fields: [farmId], references: [id])
  txnType     DrugTxnType
  quantity    Decimal     @db.Decimal(10, 2)
  batchNumber String?
  expiryDate  DateTime?
  unitCost    Decimal?    @db.Decimal(10, 2)
  txnDate     DateTime
  notes       String?
  createdById String?
  createdAt   DateTime    @default(now())
  version     Int         @default(1)

  purchases Purchase[]

  @@index([farmId, drugItemId])
  @@index([farmId, expiryDate])
  @@map("drug_transactions")
}

model Treatment {
  id             String    @id @default(uuid())
  farmId         String
  farm           Farm      @relation(fields: [farmId], references: [id])
  categoryId     Int?
  category       AnimalCategory? @relation(fields: [categoryId], references: [id])
  drugItemId     String
  drugItem       DrugItem  @relation(fields: [drugItemId], references: [id])
  batchNumber    String?
  dose           String?
  quantityUsed   Decimal?  @db.Decimal(10, 2)
  reason         String?
  administeredById String?
  treatmentDate  DateTime
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([farmId])
  @@map("treatments")
}

// ── EQUIPMENT ─────────────────────────────────────────────────────────────

enum EquipmentCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
  UNDER_REPAIR
  RETIRED
}

model Equipment {
  id           String             @id @default(uuid())
  farmId       String
  farm         Farm               @relation(fields: [farmId], references: [id])
  name         String
  category     String?
  quantity     Int                @default(1)
  condition    EquipmentCondition @default(GOOD)
  purchaseDate DateTime?
  unitCost     Decimal?           @db.Decimal(10, 2)
  location     String?
  assignedTo   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  version      Int                @default(1)

  maintenanceRecords EquipmentMaintenance[]

  @@index([farmId])
  @@map("equipment")
}

model EquipmentMaintenance {
  id                  String    @id @default(uuid())
  equipmentId         String
  equipment           Equipment @relation(fields: [equipmentId], references: [id])
  maintenanceDate     DateTime
  description         String?
  cost                Decimal?  @db.Decimal(10, 2)
  nextMaintenanceDate DateTime?
  notes               String?
  createdAt           DateTime  @default(now())

  @@index([equipmentId])
  @@map("equipment_maintenance")
}

// ── PARTIES (future-proofing: supplier/buyer today, vet/agrovet/buyer network later) ──

model Party {
  id        String   @id @default(uuid())
  farmId    String?  // null = platform-level party (Stage 2/3)
  farm      Farm?    @relation(fields: [farmId], references: [id])
  name      String
  phone     String?
  type      String   @default("supplier") // supplier | buyer | vet | agrovet | ...
  createdAt DateTime @default(now())

  feedTransactions FeedTransaction[]
  purchases        Purchase[]
  sales            Sale[]

  @@index([farmId])
  @@map("parties")
}

// ── FINANCE ───────────────────────────────────────────────────────────────

model Purchase {
  id                String    @id @default(uuid())
  farmId            String
  farm              Farm      @relation(fields: [farmId], references: [id])
  category          String    // feed | drugs | equipment | vet_services | labour | transport | utilities | repairs | other
  description       String?
  supplierPartyId   String?
  supplierParty     Party?    @relation(fields: [supplierPartyId], references: [id])
  quantity          Decimal?  @db.Decimal(10, 2)
  unitPrice         Decimal?  @db.Decimal(10, 2)
  totalAmount       Decimal   @db.Decimal(12, 2)
  paymentMethod     String?
  receiptNo         String?
  purchaseDate      DateTime
  linkedFeedTxnId   String?
  linkedFeedTxn     FeedTransaction? @relation(fields: [linkedFeedTxnId], references: [id])
  linkedDrugTxnId   String?
  linkedDrugTxn     DrugTransaction? @relation(fields: [linkedDrugTxnId], references: [id])
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  version           Int       @default(1)

  @@index([farmId, purchaseDate])
  @@map("purchases")
}

model Expense {
  id            String    @id @default(uuid())
  farmId        String
  farm          Farm      @relation(fields: [farmId], references: [id])
  category      String
  description   String?
  amount        Decimal   @db.Decimal(12, 2)
  paymentMethod String?
  expenseDate   DateTime
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  version       Int       @default(1)

  @@index([farmId, expenseDate])
  @@map("expenses")
}

model Sale {
  id                    String    @id @default(uuid())
  farmId                String
  farm                  Farm      @relation(fields: [farmId], references: [id])
  buyerPartyId          String?
  buyerParty            Party?    @relation(fields: [buyerPartyId], references: [id])
  productCategory       String    // livestock category, manure, other
  quantity              Decimal   @db.Decimal(10, 2)
  weightKg              Decimal?  @db.Decimal(10, 2)
  pricePerUnit          Decimal?  @db.Decimal(10, 2)
  totalAmount           Decimal   @db.Decimal(12, 2)
  paymentStatus         String    @default("paid")
  paymentMethod         String?
  saleDate              DateTime
  linkedAnimalMovementId String?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  version               Int       @default(1)

  @@index([farmId, saleDate])
  @@map("sales")
}

// ── NOTIFICATIONS & AUDIT ─────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id])
  type      String   // low_feed | low_drug | drug_expiring | drug_expired | maintenance_due | variance
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([farmId, isRead])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(uuid())
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id])
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  action        String
  entity        String
  entityId      String?
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  @@index([farmId, entity])
  @@map("audit_logs")
}
