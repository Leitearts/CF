# Server
PORT=3000
NODE_ENV=development

# Database (matches docker-compose service below)
DATABASE_URL="postgresql://farmos:farmos_dev_password@localhost:5432/farmos?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRY="30d"

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN="*"
